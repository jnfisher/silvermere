  },
  {
   "regex": " \\[\\d+ game minutes left\\]| \\[Last chance\\]",
   "why": "menu time-left suffix"
  },
  {
   "regex": "[A-Z ]\\x08",
   "why": "every direction name carries a random capital letter and a backspace, rewritten each slow cycle: `nJ\\borth`"
  },
  {
   "regex": "\\[HP=-?\\d+(?:/(?:MA|KAI)=-?\\d+)?",
   "why": "HP/mana in the prompt depend on earlier fights and regen"
  }
 ],
