{
 "scenario": "m2/setup/orig-account-sysop",
 "port": 2323,
 "description": "The original only: a BBS account @USER@/@PASSWORD@ through MBBSEmu's NEW dialogue (orig-account-eamon.json with the names as parameters), for the m2 statistical runs' sysops (T-040). Played with `differential.py replay --as USER:PASSWORD`; m2_live.sh then gives it the key WCCSYSOP (mbbsemu_key.py).",
 "character": {
  "user": "@USER@",
  "password": "@PASSWORD@"
 },
 "behaviours": [],
 "mask": [
  {
   "regex": "\\(Dec 30 2005 14:20:05\\)",
   "why": "build stamp of the DLL (mud_title)"
  },
  {
   "regex": " \\[\\d+ game minutes left\\]| \\[Last chance\\]",
   "why": "menu time-left suffix"
  },
  {
   "regex": "Build #\\S+|\\d{1,2}/\\d{1,2}/\\d{2,4}|\\d{1,2}:\\d{2}(?::\\d{2})?",
   "why": "MBBSEmu banner build and clock"
  }
 ],
 "steps": [
  {
   "op": "connect",
   "until": "Username:",
   "timeout": 20
  },
  {
   "send": "NEW",
   "until": "Username \\(Max",
   "timeout": 10
  },
  {
   "send": "@USER@",
   "until": "Password:",
   "timeout": 10
  },
  {
   "send": "@PASSWORD@",
   "until": "confirm:",
   "timeout": 10
  },
  {
   "send": "@PASSWORD@",
   "until": "e-Mail",
   "timeout": 10
  },
  {
   "send": "@USERLC@@example.com",
   "until": "gender",
   "timeout": 10,
   "note": "e-mail in lower case: MBBSEmu's signup takes only an address whose first character is [0-9a-z], case-sensitively (MBBSEmu v1.0-alpha-090826, HostProcess/HostRoutines/MenuRoutines.cs:609-619)"
  },
  {
   "send": "M",
   "until": "Make your selection",
   "timeout": 10,
   "note": "gender"
  },
  {
   "send": "M",
   "until": "\\[MAJORMUD\\]:",
   "timeout": 10,
   "note": "MajorMUD menu"
  },
  {
   "send": "X",
   "until": "Make your selection",
   "timeout": 10
  },
  {
   "send": "X",
   "until": "Are you sure",
   "timeout": 10
  },
  {
   "send": "Y",
   "wait": 2,
   "timeout": 10
  }
 ],
