# cp docker/.env.example docker/.env, then edit. Never commit .env.
SILVERMERE_VERSION=latest
# Placeholder text, not a secret: generate one with `openssl rand -hex 32`.
SILVERMERE_ADMIN_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Only used when the postgres service is uncommented.
POSTGRES_PASSWORD=change-me-too
